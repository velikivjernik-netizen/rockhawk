# RockHawk Review Tables — local development
# Copy to .env before `docker compose up`.
# Change every secret before exposing this host beyond localhost.

# --- Required ---
# MUST change before any non-demo use. Used to sign session tokens.
SECRET_KEY=change-me-generate-a-long-random-string

# Fallback default only. Admins can switch to openai_compatible in
# Administration → 2. AI providers & model roles without editing this file.
# Set ROCKHAWK_PIN_AI_SETTINGS=true to lock provider/URL/key/model to env.
AI_PROVIDER=mock
# ROCKHAWK_PIN_AI_SETTINGS=false

# --- Demo bootstrap ---
# Creates the fictional Northwind/Contoso matter, sample documents, and users.
SEED_DEMO=true

# Development admin. CHANGE THIS PASSWORD before any shared deployment.
# Default is published in the README so first-run is possible — treat it as compromised.
ADMIN_EMAIL=admin@rockhawk.local
ADMIN_PASSWORD=ChangeMeNow!

# --- Compose service URLs (defaults match docker-compose.yml) ---
DATABASE_URL=postgresql+psycopg://rockhawk:rockhawk@postgres:5432/rockhawk
REDIS_URL=redis://redis:6379/0
STORAGE_DIR=/data/storage

# --- Optional OpenAI-compatible provider (Open WebUI, vLLM, Ollama, etc.) ---
# From Compose on Linux this resolves via extra_hosts host-gateway.
# Fallback if that fails: http://172.17.0.1:<open-webui-port>/v1
# Do not use http://localhost:... from inside the api/worker containers.
OPENAI_COMPATIBLE_BASE_URL=http://host.docker.internal:8080/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=llama3.1

# --- Optional OIDC hook (disabled unless issuer + client id are set) ---
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8080/api/auth/oidc/callback

# --- App ---
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:8080
APP_NAME=RockHawk Review Tables
LOG_LEVEL=INFO
